GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
DEFAULT_LLM=
OPENROUTER_API_KEY=
LLM_PROXY_API_KEY=
# HTTPS/Nginx: public IP bot-хоста. Private tunnel: private IP bot-хоста.
LLM_PROXY_ALLOWED_CLIENT_CIDRS=77.222.60.149/32
# Задавайте только для reverse proxy, который перезаписывает X-Forwarded-For.
LLM_PROXY_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# bot находится на другом хосте. Для HTTPS reverse proxy оставьте
# 127.0.0.1; для WireGuard/private network укажите private IP LLM-хоста.
# Не используйте 0.0.0.0 для public HTTP в production.
LLM_PROXY_BIND_ADDRESS=127.0.0.1
