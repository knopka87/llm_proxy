# Скопируйте файл в .env и замените пустые значения.
# Для текущего production provider достаточно настроить OpenRouter.

# HTTP server / Docker port publishing
PORT=8000
# HTTPS reverse proxy: 127.0.0.1. Direct private/public binding: IP интерфейса.
# Public binding допустим только вместе с host firewall/source-IP allowlist.
LLM_PROXY_BIND_ADDRESS=127.0.0.1

# Service-to-service authentication. Должен совпадать с LLM_SERVER_API_KEY в bot.
LLM_PROXY_API_KEY=

# HTTPS/Nginx: public IP bot-хоста. Private tunnel: private IP bot-хоста.
LLM_PROXY_ALLOWED_CLIENT_CIDRS=77.222.60.149/32
# Оставьте пустым при прямом подключении. Для reverse proxy укажите его CIDR
# только если proxy перезаписывает X-Forwarded-For, например 127.0.0.1/32,::1/128.
LLM_PROXY_TRUSTED_PROXY_CIDRS=

# OpenRouter (текущий production provider)
OPENROUTER_API_KEY=
OPENROUTER_DETECT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_PARSE_MODEL=openai/gpt-4.1-mini
OPENROUTER_HINT_MODEL=openai/gpt-4.1-mini
OPENROUTER_CHECK_MODEL=openai/gpt-4.1-mini
# Пустое значение использует OPENROUTER_HINT_MODEL для analogue.
OPENROUTER_ANALOGUE_MODEL=

# Optional direct providers / legacy v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DETECT_MODEL=gemini-2.0-flash-lite
GEMINI_PARSE_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional filesystem overrides. Docker image/Compose already set these paths.
PROMPT_DIR=./api/internal
TEMPLATES_DIR=./api/internal/v2/templates
